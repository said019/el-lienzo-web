---
import { Image } from 'astro:assets';
import { buildZoomGroup } from '../../lib/zoom';
import montajeRosa from '../../assets/gallery/montaje-rosa.webp';
import mesasJardin from '../../assets/gallery/mesas-jardin.webp';
import montajeMediterraneo from '../../assets/gallery/montaje-mediterraneo.webp';
import fachadaEdificio from '../../assets/gallery/fachada-edificio.webp';

const INSTAGRAM_URL = 'https://www.instagram.com/ellienzo.eventos/';

// Selección de la guía: dos montajes, mesas en el jardín y la fachada.
const shots = [
  {
    src: montajeRosa,
    alt: 'Mesa larga vestida en tonos coral y verde olivo, con vajilla, cristalería y flores de temporada',
    caption: 'Mesa en tonos rosa',
  },
  {
    src: mesasJardin,
    alt: 'Mesas negras preparadas para una celebración al aire libre en los jardines de El Lienzo',
    caption: 'Celebración en el jardín',
  },
  {
    src: montajeMediterraneo,
    alt: 'Banquete bajo carpa beige con mesas redondas, olivos y cítricos en los centros de mesa',
    caption: 'Banquete bajo carpa',
  },
  {
    src: fachadaEdificio,
    alt: 'Fachada de ladrillo y muros blancos de El Lienzo vista desde el jardín',
    caption: 'Arquitectura de El Lienzo',
  },
];

const zoomShots = await buildZoomGroup(shots, 'galeria');
---

<section id="galeria" class="gallery" aria-labelledby="gallery-title">
  <div class="shell gallery__shell">
    <header class="gallery__header">
      <div class="gallery__intro">
        <p class="eyebrow">Historias que ya tomaron forma</p>
        <h2 id="gallery-title" class="section-heading gallery__title">
          Un espacio distinto en cada <em>celebración</em>
        </h2>
      </div>

      <a class="button--ghost gallery__action" href={INSTAGRAM_URL} rel="noreferrer">
        Ver más en Instagram
      </a>
    </header>

    <hr class="rule gallery__rule" />

    <ul class="gallery__strip" role="list" data-reveal>
      {
        zoomShots.map(({ photo, zoom }) => (
          <li class="gallery__item">
            <button class="zoom" type="button" disabled {...zoom}>
              <Image
                class="gallery__image"
                src={photo.src}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                widths={[300, 480, 640, 900, 1080].filter((width) => width <= photo.src.width)}
                quality={88}
                sizes="(max-width: 47.99rem) calc(50vw - 1.5rem), (max-width: 63.99rem) calc(25vw - 1.5rem), 18.5rem"
              />
              <span class="sr-only"> (ampliar)</span>
            </button>
          </li>
        ))
      }
    </ul>

    <p class="note gallery__note">Las imágenes muestran distintos montajes e inspiraciones que no representan ningún paquete en específico.</p>
  </div>
</section>
