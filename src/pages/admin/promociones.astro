---
import BaseLayout from "../../layouts/BaseLayout.astro";
import logoElLienzo from "../../assets/brand/logo-el-lienzo.png";

export const prerender = false;
---

<BaseLayout
  title="Promociones | Administración El Lienzo"
  description="Panel privado para administrar las promociones de El Lienzo."
  noIndex
>
  <main class="admin" id="contenido">
    <header class="admin__header">
      <a class="admin__brand" href="/" aria-label="Ir al sitio de El Lienzo">
        <img src={logoElLienzo.src} alt="El Lienzo" width="445" height="512" />
      </a>
      <div>
        <p class="admin__kicker">Administración</p>
        <h1>Promociones</h1>
      </div>
      <a class="text-link" href="/" target="_blank" rel="noreferrer">
        Ver sitio
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M7 13 13 7M8 7h5v5" />
        </svg>
      </a>
    </header>

    <section class="access" data-access-panel>
      <div class="access__mark" aria-hidden="true">
        <span></span>
      </div>
      <div class="access__copy">
        <p class="admin__kicker">Acceso privado</p>
        <h2>Edita campañas sin tocar código</h2>
        <p>
          Ingresa la contraseña del administrador. Se conservará únicamente
          mientras esta pestaña permanezca abierta.
        </p>
      </div>
      <form class="access__form" data-login-form>
        <label for="admin-password">Contraseña</label>
        <div class="password-field">
          <input
            id="admin-password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
          />
          <button type="button" data-toggle-password aria-label="Mostrar contraseña">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M2.8 12s3.4-5.5 9.2-5.5 9.2 5.5 9.2 5.5-3.4 5.5-9.2 5.5S2.8 12 2.8 12Z" />
              <circle cx="12" cy="12" r="2.7" />
            </svg>
          </button>
        </div>
        <p class="form-message" data-login-message role="status"></p>
        <button class="button-primary" type="submit" data-login-submit>
          Entrar al panel
        </button>
      </form>
    </section>

    <section class="workspace" data-workspace hidden>
      <aside class="campaigns" aria-label="Campañas">
        <div class="campaigns__heading">
          <div>
            <p class="admin__kicker">Campañas</p>
            <h2>Contenido</h2>
          </div>
          <span class="campaigns__count" data-campaign-count>0</span>
        </div>
        <div class="campaigns__list" data-campaign-list></div>
        <button class="button-secondary campaigns__new" type="button" data-new-campaign>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12" /></svg>
          Nueva campaña
        </button>
        <button class="logout" type="button" data-logout>Cerrar sesión</button>
      </aside>

      <form class="editor" data-promotion-form>
        <div class="editor__heading">
          <div>
            <div class="editor__status-row">
              <span class="status-pill" data-editor-status>Sin cambios</span>
              <span class="revision" data-revision-label>Versión 1</span>
            </div>
            <h2 data-editor-title>Editar promoción</h2>
          </div>
          <label class="publish-toggle">
            <input type="checkbox" name="enabled" />
            <span aria-hidden="true"></span>
            Publicada
          </label>
        </div>

        <div class="form-section">
          <div class="form-section__title">
            <span>01</span>
            <div>
              <h3>Mensaje</h3>
              <p>El contenido principal que verán tus visitantes.</p>
            </div>
          </div>
          <div class="field-grid">
            <label class="field field--wide">
              <span>Identificador</span>
              <input name="id" required readonly />
              <small>No cambia después de crear la campaña.</small>
            </label>
            <label class="field">
              <span>Antetítulo</span>
              <input name="eyebrow" maxlength="50" placeholder="Oferta especial" />
            </label>
            <label class="field field--wide">
              <span>Título</span>
              <input name="title" maxlength="80" required />
            </label>
            <label class="field field--wide">
              <span>Descripción</span>
              <textarea name="body" maxlength="700" rows="6" required></textarea>
            </label>
            <label class="field field--wide">
              <span>Vigencia y condiciones</span>
              <textarea name="note" maxlength="300" rows="3"></textarea>
            </label>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section__title">
            <span>02</span>
            <div>
              <h3>Programación</h3>
              <p>La campaña se activa y termina automáticamente.</p>
            </div>
          </div>
          <div class="field-grid">
            <label class="field">
              <span>Inicio</span>
              <input name="startsAt" type="datetime-local" required />
            </label>
            <label class="field">
              <span>Fin</span>
              <input name="endsAt" type="datetime-local" required />
            </label>
            <label class="field">
              <span>Prioridad</span>
              <input name="priority" type="number" min="-100" max="100" required />
              <small>El número más alto aparece primero.</small>
            </label>
            <label class="field">
              <span>Estilo</span>
              <select name="tone">
                <option value="canvas">Lienzo claro</option>
                <option value="terracotta">Terracota</option>
                <option value="forest">Bosque</option>
              </select>
            </label>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section__title">
            <span>03</span>
            <div>
              <h3>Imagen y botón</h3>
              <p>Sube tu imagen y ajusta el encuadre antes de publicar.</p>
            </div>
          </div>
          <div class="field-grid">
            <div class="image-upload field--wide">
              <label class="field" for="promotion-image-file">
                <span>Subir imagen</span>
                <input id="promotion-image-file" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="upload-help upload-message" data-image-file />
                <small id="upload-help">Selecciona una foto de tu celular o computadora. JPG, PNG o WebP, hasta 10 MB.</small>
              </label>
              <p id="upload-message" class="form-message" data-upload-message role="status"></p>
              <input name="imageSrc" type="hidden" />
              <input name="imageWidth" type="hidden" />
              <input name="imageHeight" type="hidden" />
            </div>
            <fieldset class="image-framing field--wide" data-image-framing hidden>
              <legend>Ajustar imagen</legend>
              <div class="image-framing__previews">
                <figure>
                  <div class="image-framing__frame image-framing__frame--mobile"><img data-frame-image alt="Encuadre en móvil" /></div>
                  <figcaption>Móvil · imagen horizontal</figcaption>
                </figure>
                <figure>
                  <div class="image-framing__frame image-framing__frame--desktop"><img data-frame-image alt="Encuadre en escritorio" /></div>
                  <figcaption>Escritorio · imagen vertical</figcaption>
                </figure>
              </div>
              <label class="field">
                <span>Cómo se ajusta</span>
                <select name="imageFit">
                  <option value="contain">Imagen completa (sin recortar)</option>
                  <option value="cover">Llenar el espacio (recortar bordes)</option>
                </select>
                <small>Para flyers con texto, usa imagen completa y zoom al 100%. El espacio libre toma el color del fondo.</small>
              </label>
              <label class="field">
                <span>Zoom <output data-image-zoom-label>100%</output></span>
                <input name="imageZoom" type="range" min="1" max="2.5" step="0.05" value="1" />
              </label>
              <label class="field">
                <span>Posición horizontal <output data-image-x-label>50%</output></span>
                <input name="imagePositionX" type="range" min="0" max="100" value="50" />
                <small>Izquierda → derecha</small>
              </label>
              <label class="field">
                <span>Posición vertical <output data-image-y-label>50%</output></span>
                <input name="imagePositionY" type="range" min="0" max="100" value="50" />
                <small>Arriba → abajo</small>
              </label>
              <div class="image-framing__actions">
                <button type="button" class="button-secondary" data-reset-image>Restablecer encuadre</button>
                <button type="button" class="button-danger" data-remove-image>Quitar imagen</button>
              </div>
              <p class="image-framing__hint">Vista de encuadre de referencia. Guarda los cambios para aplicar la imagen y su ajuste al pop-up.</p>
            </fieldset>
            <label class="field field--wide">
              <span>Descripción de imagen</span>
              <input name="imageAlt" maxlength="160" />
            </label>
            <label class="field">
              <span>Texto del botón</span>
              <input name="ctaLabel" maxlength="40" required />
            </label>
            <label class="field">
              <span>Destino del botón</span>
              <input name="ctaHref" required placeholder="#cotiza" />
            </label>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section__title">
            <span>04</span>
            <div>
              <h3>Cuándo aparece</h3>
              <p>Define el momento menos invasivo para mostrarla.</p>
            </div>
          </div>
          <div class="field-grid">
            <label class="field">
              <span>Disparador</span>
              <select name="triggerMode">
                <option value="either">Tiempo o desplazamiento</option>
                <option value="delay">Solo por tiempo</option>
                <option value="scroll">Solo al desplazarse</option>
              </select>
            </label>
            <label class="field">
              <span>Espera en segundos</span>
              <input name="delaySeconds" type="number" min="3" max="30" required />
            </label>
            <label class="field">
              <span>Avance de página (%)</span>
              <input name="scrollPercent" type="number" min="10" max="80" required />
            </label>
          </div>
        </div>

        <div class="editor__actions">
          <p class="form-message" data-save-message role="status"></p>
          <button class="button-danger" type="button" data-delete-campaign>
            Eliminar
          </button>
          <button class="button-primary" type="submit" data-save-button>
            Guardar y publicar cambios
          </button>
        </div>
      </form>

      <aside class="preview" aria-label="Vista previa de la promoción">
        <div class="preview__heading">
          <div>
            <p class="admin__kicker">Vista previa</p>
            <h2>Así se verá</h2>
          </div>
          <span>En vivo</span>
        </div>
        <div class="preview__stage">
          <article class="preview-card" data-preview-card data-tone="canvas">
            <button type="button" aria-label="Cerrar vista previa">
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" /></svg>
            </button>
            <div class="preview-card__media" data-preview-media>
              <img data-preview-image alt="" />
              <div class="preview-card__placeholder" data-preview-placeholder>
                Vista de imagen
              </div>
            </div>
            <div class="preview-card__content">
              <p class="preview-card__eyebrow" data-preview-eyebrow></p>
              <h3 data-preview-title></h3>
              <p class="preview-card__body" data-preview-body></p>
              <p class="preview-card__note" data-preview-note></p>
              <span class="preview-card__cta" data-preview-cta></span>
            </div>
          </article>
        </div>
      </aside>
    </section>
  </main>
</BaseLayout>

<script>
  import { applyPromotionImageFrame, type PromotionImage } from "../../lib/promotions";
  type PromotionTone = "canvas" | "terracotta" | "forest";
  type TriggerMode = "delay" | "scroll" | "either";

  interface Promotion {
    id: string;
    revision: number;
    enabled: boolean;
    priority: number;
    startsAt: string;
    endsAt: string;
    eyebrow?: string;
    title: string;
    body: string;
    note?: string;
    image?: PromotionImage | undefined;
    cta: { label: string; href: string };
    trigger: { mode: TriggerMode; delayMs: number; scrollPercent: number };
    tone: PromotionTone;
  }

  const accessPanel = document.querySelector<HTMLElement>("[data-access-panel]");
  const workspace = document.querySelector<HTMLElement>("[data-workspace]");
  const loginForm = document.querySelector<HTMLFormElement>("[data-login-form]");
  const loginMessage = document.querySelector<HTMLElement>("[data-login-message]");
  const loginSubmit = document.querySelector<HTMLButtonElement>("[data-login-submit]");
  const form = document.querySelector<HTMLFormElement>("[data-promotion-form]");
  const campaignList = document.querySelector<HTMLElement>("[data-campaign-list]");
  const campaignCount = document.querySelector<HTMLElement>("[data-campaign-count]");
  const saveMessage = document.querySelector<HTMLElement>("[data-save-message]");
  const saveButton = document.querySelector<HTMLButtonElement>("[data-save-button]");
  const editorStatus = document.querySelector<HTMLElement>("[data-editor-status]");
  const editorTitle = document.querySelector<HTMLElement>("[data-editor-title]");
  const revisionLabel = document.querySelector<HTMLElement>("[data-revision-label]");

  let password = "";
  let promotions: Promotion[] = [];
  let selectedId = "";
  let dirty = false;
  let uploading = false;
  let uploadController: AbortController | undefined;
  const imageFile = document.querySelector<HTMLInputElement>("[data-image-file]");
  const uploadMessage = document.querySelector<HTMLElement>("[data-upload-message]");

  const field = <T extends HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
    name: string,
  ): T => form?.elements.namedItem(name) as T;

  const value = (name: string): string => field(name).value.trim();
  const optionalNumber = (name: string): number | undefined => {
    const raw = value(name);
    return raw ? Number(raw) : undefined;
  };

  const pad = (part: number): string => String(part).padStart(2, "0");
  const toLocalInput = (iso: string): string => {
    const date = new Date(iso);
    if (!Number.isFinite(date.getTime())) return "";
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
  };
  const toIso = (local: string): string => new Date(local).toISOString();

  const selectedPromotion = (): Promotion | undefined =>
    promotions.find((promotion) => promotion.id === selectedId);

  function createCampaign(): Promotion {
    const now = new Date();
    const end = new Date(now);
    end.setDate(end.getDate() + 30);
    const suffix = Date.now().toString().slice(-6);
    return {
      id: `campana-${suffix}`,
      revision: 1,
      enabled: false,
      priority: 0,
      startsAt: now.toISOString(),
      endsAt: end.toISOString(),
      eyebrow: "Nueva promoción",
      title: "Escribe aquí el título de la campaña",
      body: "Agrega los beneficios y condiciones principales de esta promoción.",
      note: "Consulta términos y condiciones.",
      cta: { label: "Cotiza tu evento", href: "#cotiza" },
      trigger: { mode: "either", delayMs: 8000, scrollPercent: 35 },
      tone: "canvas",
    };
  }

  function setMessage(
    element: HTMLElement | null,
    message: string,
    state: "error" | "success" | "neutral" = "neutral",
  ): void {
    if (!element) return;
    element.textContent = message;
    element.dataset.state = state;
  }

  function setDirty(nextDirty: boolean): void {
    dirty = nextDirty;
    if (!editorStatus) return;
    editorStatus.textContent = dirty ? "Cambios sin guardar" : "Guardado";
    editorStatus.dataset.state = dirty ? "dirty" : "saved";
  }

  function renderCampaignList(): void {
    if (!campaignList) return;
    campaignList.replaceChildren();

    [...promotions]
      .sort((a, b) => b.priority - a.priority)
      .forEach((promotion, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.disabled = uploading;
        button.className = "campaign-item";
        button.dataset.selected = String(promotion.id === selectedId);
        button.style.setProperty("--campaign-index", String(index));

        const indicator = document.createElement("span");
        indicator.className = "campaign-item__indicator";
        indicator.dataset.enabled = String(promotion.enabled);

        const copy = document.createElement("span");
        copy.className = "campaign-item__copy";
        const title = document.createElement("strong");
        title.textContent = promotion.title;
        const meta = document.createElement("small");
        meta.textContent = promotion.enabled ? "Publicada" : "Borrador";
        copy.append(title, meta);

        button.append(indicator, copy);
        button.addEventListener("click", () => {
          selectedId = promotion.id;
          renderCampaignList();
          fillForm(promotion);
        });
        campaignList.append(button);
      });

    if (campaignCount) campaignCount.textContent = String(promotions.length);
  }

  function fillForm(promotion: Promotion): void {
    if (!form) return;
    field<HTMLInputElement>("id").value = promotion.id;
    field<HTMLInputElement>("enabled").checked = promotion.enabled;
    field<HTMLInputElement>("priority").value = String(promotion.priority);
    field<HTMLInputElement>("startsAt").value = toLocalInput(promotion.startsAt);
    field<HTMLInputElement>("endsAt").value = toLocalInput(promotion.endsAt);
    field<HTMLInputElement>("eyebrow").value = promotion.eyebrow ?? "";
    field<HTMLInputElement>("title").value = promotion.title;
    field<HTMLTextAreaElement>("body").value = promotion.body;
    field<HTMLTextAreaElement>("note").value = promotion.note ?? "";
    field<HTMLInputElement>("imageSrc").value = promotion.image?.src ?? "";
    field<HTMLInputElement>("imageAlt").value = promotion.image?.alt ?? "";
    field<HTMLSelectElement>("imageFit").value = promotion.image?.fit ?? "cover";
    field<HTMLInputElement>("imageZoom").value = String(promotion.image?.zoom ?? 1);
    field<HTMLInputElement>("imagePositionX").value = String(promotion.image?.positionX ?? 50);
    field<HTMLInputElement>("imagePositionY").value = String(promotion.image?.positionY ?? 50);
    if (imageFile) imageFile.value = "";
    setMessage(uploadMessage, "");
    field<HTMLInputElement>("imageWidth").value = promotion.image?.width
      ? String(promotion.image.width)
      : "";
    field<HTMLInputElement>("imageHeight").value = promotion.image?.height
      ? String(promotion.image.height)
      : "";
    field<HTMLInputElement>("ctaLabel").value = promotion.cta.label;
    field<HTMLInputElement>("ctaHref").value = promotion.cta.href;
    field<HTMLSelectElement>("triggerMode").value = promotion.trigger.mode;
    field<HTMLInputElement>("delaySeconds").value = String(
      promotion.trigger.delayMs / 1000,
    );
    field<HTMLInputElement>("scrollPercent").value = String(
      promotion.trigger.scrollPercent,
    );
    field<HTMLSelectElement>("tone").value = promotion.tone;

    if (editorTitle) editorTitle.textContent = promotion.title;
    if (revisionLabel) revisionLabel.textContent = `Versión ${promotion.revision}`;
    setMessage(saveMessage, "");
    renderPreview(promotion);
  }

  function readForm(): Promotion {
    const existing = selectedPromotion();
    const imageSrc = value("imageSrc");
    const imageWidth = optionalNumber("imageWidth");
    const imageHeight = optionalNumber("imageHeight");

    return {
      id: value("id"),
      revision: existing?.revision ?? 1,
      enabled: field<HTMLInputElement>("enabled").checked,
      priority: Number(value("priority")),
      startsAt: toIso(value("startsAt")),
      endsAt: toIso(value("endsAt")),
      ...(value("eyebrow") ? { eyebrow: value("eyebrow") } : {}),
      title: value("title"),
      body: field<HTMLTextAreaElement>("body").value.trim(),
      ...(field<HTMLTextAreaElement>("note").value.trim()
        ? { note: field<HTMLTextAreaElement>("note").value.trim() }
        : {}),
      ...(imageSrc
        ? {
            image: {
              src: imageSrc,
              alt: value("imageAlt"),
              fit: value("imageFit") as "cover" | "contain",
              zoom: Number(value("imageZoom")),
              positionX: Number(value("imagePositionX")),
              positionY: Number(value("imagePositionY")),
              ...(imageWidth ? { width: imageWidth } : {}),
              ...(imageHeight ? { height: imageHeight } : {}),
            },
          }
        : {}),
      cta: { label: value("ctaLabel"), href: value("ctaHref") },
      trigger: {
        mode: value("triggerMode") as TriggerMode,
        delayMs: Number(value("delaySeconds")) * 1000,
        scrollPercent: Number(value("scrollPercent")),
      },
      tone: value("tone") as PromotionTone,
    };
  }

  function replaceSelected(promotion: Promotion): void {
    promotions = promotions.map((item) =>
      item.id === selectedId ? promotion : item,
    );
  }

  function renderPreview(promotion: Promotion): void {
    const card = document.querySelector<HTMLElement>("[data-preview-card]");
    const eyebrow = document.querySelector<HTMLElement>("[data-preview-eyebrow]");
    const title = document.querySelector<HTMLElement>("[data-preview-title]");
    const body = document.querySelector<HTMLElement>("[data-preview-body]");
    const note = document.querySelector<HTMLElement>("[data-preview-note]");
    const cta = document.querySelector<HTMLElement>("[data-preview-cta]");
    const image = document.querySelector<HTMLImageElement>("[data-preview-image]");
    const placeholder = document.querySelector<HTMLElement>("[data-preview-placeholder]");

    if (card) card.dataset.tone = promotion.tone;
    if (eyebrow) eyebrow.textContent = promotion.eyebrow ?? "";
    if (title) title.textContent = promotion.title;
    if (body) body.textContent = promotion.body;
    if (note) note.textContent = promotion.note ?? "";
    if (cta) cta.textContent = promotion.cta.label;
    const framing = document.querySelector<HTMLElement>("[data-image-framing]");
    if (framing) framing.hidden = !promotion.image?.src;
    document.querySelectorAll<HTMLImageElement>("[data-frame-image]").forEach((frame) => {
      if (promotion.image) {
        if (frame.getAttribute("src") !== promotion.image.src) frame.src = promotion.image.src;
        applyPromotionImageFrame(frame, promotion.image);
      } else { frame.removeAttribute("src"); }
    });
    const labels = {
      "[data-image-zoom-label]": Math.round((promotion.image?.zoom ?? 1) * 100),
      "[data-image-x-label]": promotion.image?.positionX ?? 50,
      "[data-image-y-label]": promotion.image?.positionY ?? 50,
    };
    Object.entries(labels).forEach(([selector, number]) => {
      const label = document.querySelector(selector);
      if (label) label.textContent = `${number}%`;
    });

    if (image && placeholder) {
      if (promotion.image?.src) {
        if (image.getAttribute("src") !== promotion.image.src) image.src = promotion.image.src;
        image.alt = promotion.image.alt;
        applyPromotionImageFrame(image, promotion.image);
        image.hidden = false;
        placeholder.hidden = true;
        image.onerror = () => {
          image.hidden = true;
          placeholder.hidden = false;
          placeholder.textContent = "No se pudo cargar la imagen";
        };
      } else {
        image.removeAttribute("src");
        image.hidden = true;
        placeholder.hidden = false;
        placeholder.textContent = "Vista de imagen";
      }
    }
  }

  function resetFrame(): void {
    field<HTMLSelectElement>("imageFit").value = "contain";
    field<HTMLInputElement>("imageZoom").value = "1";
    field<HTMLInputElement>("imagePositionX").value = "50";
    field<HTMLInputElement>("imagePositionY").value = "50";
  }

  // Image changes remain editable even while a text/date field is incomplete.
  function syncImage(): void {
    const selected = selectedPromotion();
    if (!selected) return;
    selected.image = value("imageSrc") ? {
      src: value("imageSrc"),
      alt: value("imageAlt"),
      width: optionalNumber("imageWidth"),
      height: optionalNumber("imageHeight"),
      fit: value("imageFit") as "cover" | "contain",
      zoom: Number(value("imageZoom")),
      positionX: Number(value("imagePositionX")),
      positionY: Number(value("imagePositionY")),
    } : undefined;
    renderPreview(selected);
    setDirty(true);
  }

  document.querySelector("[data-image-framing]")?.addEventListener("input", syncImage);
  document.querySelector("[data-reset-image]")?.addEventListener("click", () => {
    resetFrame();
    syncImage();
  });
  document.querySelector("[data-remove-image]")?.addEventListener("click", () => {
    if (uploading) return;
    ["imageSrc", "imageWidth", "imageHeight", "imageAlt"].forEach((name) => { field(name).value = ""; });
    if (imageFile) imageFile.value = "";
    setMessage(uploadMessage, "Imagen retirada de esta campaña. Guarda para aplicar el cambio.");
    syncImage();
  });

  imageFile?.addEventListener("change", async () => {
    const file = imageFile.files?.[0];
    if (!file || uploading) return;
    if (!["image/jpeg", "image/png", "image/webp"].includes(file.type)) {
      setMessage(uploadMessage, "Usa una imagen JPG, PNG o WebP.", "error");
      imageFile.value = "";
      return;
    }
    if (!file.size || file.size > 10 * 1024 * 1024) {
      setMessage(uploadMessage, "La imagen debe pesar como máximo 10 MB y no estar vacía.", "error");
      imageFile.value = "";
      return;
    }
    const campaignId = selectedId;
    const controller = new AbortController();
    uploadController = controller;
    uploading = true;
    imageFile.disabled = true;
    if (saveButton) saveButton.disabled = true;
    document.querySelectorAll<HTMLButtonElement>("[data-new-campaign], [data-delete-campaign], [data-remove-image]").forEach((button) => { button.disabled = true; });
    renderCampaignList();
    setMessage(uploadMessage, "Subiendo y preparando imagen…");
    try {
      const data = new FormData();
      data.set("image", file);
      const response = await fetch("/api/promotion-images", {
        method: "POST", headers: { Authorization: `Bearer ${password}` },
        body: data, signal: controller.signal,
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error ?? "No se pudo subir la imagen.");
      if (controller.signal.aborted || selectedId !== campaignId) return;
      field<HTMLInputElement>("imageSrc").value = result.image.src;
      field<HTMLInputElement>("imageWidth").value = String(result.image.width);
      field<HTMLInputElement>("imageHeight").value = String(result.image.height);
      resetFrame();
      syncImage();
      setMessage(uploadMessage, "Imagen lista. Ajusta el encuadre y guarda los cambios para publicarla.", "success");
    } catch (error) {
      if (!controller.signal.aborted) setMessage(uploadMessage, error instanceof Error ? error.message : "No se pudo subir. Intenta nuevamente.", "error");
    } finally {
      uploading = false;
      uploadController = undefined;
      imageFile.disabled = false;
      imageFile.value = "";
      if (saveButton) saveButton.disabled = false;
      document.querySelectorAll<HTMLButtonElement>("[data-new-campaign], [data-delete-campaign], [data-remove-image]").forEach((button) => { button.disabled = false; });
      renderCampaignList();
    }
  });

  async function loadPromotions(): Promise<void> {
    const response = await fetch("/api/promotions", {
      headers: { Authorization: `Bearer ${password}` },
    });
    const result = await response.json();
    if (!response.ok) throw new Error(result.error ?? "No se pudo entrar al panel.");
    promotions = result.promotions;
    selectedId = promotions[0]?.id ?? "";
  }

  loginForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    password = new FormData(loginForm).get("password")?.toString() ?? "";
    if (!password) return;

    if (loginSubmit) {
      loginSubmit.disabled = true;
      loginSubmit.textContent = "Verificando…";
    }
    setMessage(loginMessage, "Verificando acceso…");

    try {
      await loadPromotions();
      if (accessPanel) accessPanel.hidden = true;
      if (workspace) workspace.hidden = false;
      renderCampaignList();
      const selected = selectedPromotion();
      if (selected) fillForm(selected);
      setDirty(false);
    } catch (error) {
      setMessage(
        loginMessage,
        error instanceof Error ? error.message : "No se pudo entrar al panel.",
        "error",
      );
    } finally {
      if (loginSubmit) {
        loginSubmit.disabled = false;
        loginSubmit.textContent = "Entrar al panel";
      }
    }
  });

  form?.addEventListener("input", (event) => {
    if (event.target === imageFile) return;
    if (!form.checkValidity()) return;
    try {
      const promotion = readForm();
      replaceSelected(promotion);
      renderPreview(promotion);
      if (editorTitle) editorTitle.textContent = promotion.title;
      renderCampaignList();
      setDirty(true);
    } catch {
      setDirty(true);
    }
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (uploading) return;
    if (!form.reportValidity()) return;

    const promotion = readForm();
    promotion.revision = (selectedPromotion()?.revision ?? 0) + 1;
    replaceSelected(promotion);

    if (saveButton) {
      saveButton.disabled = true;
      saveButton.textContent = "Guardando…";
    }
    setMessage(saveMessage, "Guardando los cambios…");

    try {
      const response = await fetch("/api/promotions", {
        method: "PUT",
        headers: {
          Authorization: `Bearer ${password}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ promotions }),
      });
      const result = await response.json();
      if (!response.ok) {
        const detail = Array.isArray(result.issues)
          ? result.issues.map((issue: { message: string }) => issue.message).join(" ")
          : "";
        throw new Error(`${result.error ?? "No se pudo guardar."} ${detail}`.trim());
      }

      promotions = result.promotions;
      const saved = selectedPromotion();
      if (saved) fillForm(saved);
      renderCampaignList();
      setDirty(false);
      setMessage(saveMessage, "Cambios publicados correctamente.", "success");
    } catch (error) {
      setMessage(
        saveMessage,
        error instanceof Error ? error.message : "No se pudieron guardar los cambios.",
        "error",
      );
    } finally {
      if (saveButton) {
        saveButton.disabled = false;
        saveButton.textContent = "Guardar y publicar cambios";
      }
    }
  });

  document.querySelector("[data-new-campaign]")?.addEventListener("click", () => {
    if (uploading) return;
    const campaign = createCampaign();
    promotions.push(campaign);
    selectedId = campaign.id;
    renderCampaignList();
    fillForm(campaign);
    setDirty(true);
    field<HTMLInputElement>("title").focus();
  });

  document.querySelector("[data-delete-campaign]")?.addEventListener("click", () => {
    if (uploading) return;
    if (promotions.length <= 1) {
      setMessage(saveMessage, "Debe existir al menos una campaña.", "error");
      return;
    }
    const selected = selectedPromotion();
    if (!selected || !window.confirm(`¿Eliminar la campaña “${selected.title}”?`)) return;
    promotions = promotions.filter((promotion) => promotion.id !== selectedId);
    selectedId = promotions[0]?.id ?? "";
    renderCampaignList();
    const next = selectedPromotion();
    if (next) fillForm(next);
    setDirty(true);
    setMessage(saveMessage, "Campaña eliminada. Guarda para confirmar el cambio.");
  });

  document.querySelector("[data-logout]")?.addEventListener("click", () => {
    uploadController?.abort();
    password = "";
    promotions = [];
    selectedId = "";
    loginForm?.reset();
    if (workspace) workspace.hidden = true;
    if (accessPanel) accessPanel.hidden = false;
    setMessage(loginMessage, "");
  });

  document.querySelector("[data-toggle-password]")?.addEventListener("click", (event) => {
    const input = document.querySelector<HTMLInputElement>("#admin-password");
    if (!input) return;
    const button = event.currentTarget as HTMLButtonElement;
    input.type = input.type === "password" ? "text" : "password";
    button.setAttribute(
      "aria-label",
      input.type === "password" ? "Mostrar contraseña" : "Ocultar contraseña",
    );
  });

  window.addEventListener("beforeunload", (event) => {
    if (!dirty) return;
    event.preventDefault();
  });
</script>

